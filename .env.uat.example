# Copy to .env.uat on EC2 or locally
COMPOSE_PROJECT_NAME=taxima-uat
TAXIMA_ENV=uat

# Host ports (see docs/PORTS.md)
API_HOST_PORT=3200
CRM_HOST_PORT=3201
MYSQL_HOST_PORT=3311

MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=taxima_uat
MYSQL_USER=taxima
MYSQL_PASSWORD=change_me_db

JWT_SECRET=change_me_jwt_uat_min_32_chars________
JWT_EXPIRES_IN=7d
# 司機 App Firebase OTP session（預設 180d，除非登出）
DRIVER_JWT_EXPIRES_IN=180d
# CRM phone OTP session (admin JWT)
CRM_JWT_EXPIRES_IN=24h
# 乘客免 OTP phone-login（用 SMS OTP 時設 false）
PASSENGER_PHONE_LOGIN_ENABLED=false
# Same value as Firebase web apiKey (CRM OTP + API token verify)
FIREBASE_WEB_API_KEY=
CORS_ORIGIN=https://taxima.hkcodai.space

# Maps / push (optional for CRM phase)
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# 司機 App push（external_id = driverId）
ONESIGNAL_DRIVER_APP_ID=
ONESIGNAL_DRIVER_REST_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=20

# Driver order visibility (seconds)
ORDER_ADMIN_PREVIEW_SECONDS=2

# 司機接單距上車點 >5km 時電郵 admin（預約單不送）
ADMIN_ALERT_EMAIL=yranma26@gmail.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Google Gemini（CRM 司機證件圖片分析；只設在 API，勿寫入 CRM 前端）
# GEMINI_API_KEY=
# GEMINI_DEFAULT_IMAGE_MODEL=flash
