{
  "name": "@taxima/driver",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start --port 8082",
    "android": "expo run:android",
    "preios": "npm exec --prefix ../.. -- patch-package",
    "ios": "expo run:ios --port 8082",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "postprebuild": "node ./scripts/ensureExpoNativeLink.mjs && node ./scripts/sync-splash-assets.mjs && node ./scripts/normalize-android-launcher-png.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/crashlytics": "^23.8.8",
    "@react-navigation/bottom-tabs": "^7.4.2",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "expo": "~57.0.27",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "^57.0.22",
    "expo-constants": "~57.0.21",
    "expo-firebase-recaptcha": "^2.3.1",
    "expo-image-picker": "~57.0.20",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "^57.1.1",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.3",
    "firebase": "^11.10.0",
    "onesignal-expo-plugin": "^2.7.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-onesignal": "^5.5.14",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.16.1",
    "socket.io-client": "^4.8.4"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-firebase-core"
        ]
      }
    }
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  }
}
