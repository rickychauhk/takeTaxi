{
  "name": "@taxima/passenger",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^23.8.6",
    "@react-native-firebase/crashlytics": "^23.8.6",
    "expo": "~57.0.27",
    "expo-build-properties": "^57.0.22",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo-constants": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-firebase-recaptcha": "^2.3.1",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "firebase": "^11.10.0",
    "onesignal-expo-plugin": "^2.7.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-onesignal": "^5.5.14",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo start --port 8081",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "postprebuild": "node ./scripts/patch-ios-podfile.mjs && node ./scripts/patch-ios-app-delegate.mjs && node ./scripts/sync-splash-assets.mjs && node ./scripts/normalize-android-launcher-png.mjs && node ./scripts/patch-ios-podfile-properties.mjs",
    "preios": "node scripts/check-firebase-ios.mjs && node scripts/sync-google-services-ios.mjs && cd ios && EXPO_USE_PRECOMPILED_MODULES=0 pod install --repo-update && node ../scripts/sync-google-services-ios.mjs",
    "ios": "REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo run:ios --port 8081",
    "web": "expo start --web"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-firebase-core"
        ]
      }
    }
  }
}
